# AI Contracts — Supabase + Groq production configuration
# NEVER commit real credentials to this repository.
# NEVER prefix server secrets with VITE_. VITE_* variables are bundled for the browser.

# -----------------------------------------------------------------------------
# SERVER-ONLY SECURITY
# -----------------------------------------------------------------------------
# Long random secret used for AES-256-GCM encryption and HMAC fingerprints.
ENCRYPTION_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# Supabase project URL.
SUPABASE_URL="https://your-project.supabase.co"

# Preferred current Supabase server key. Keep this server-side only.
# If your project still exposes the legacy service_role key, the application
# also accepts SUPABASE_SERVICE_ROLE_KEY as a fallback.
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"
SUPABASE_SERVICE_ROLE_KEY=""

# Hard platform limit for the Groq key pool. The supplied SQL migration also
# enforces a 20-key database ceiling.
GROQ_MAX_CREDENTIALS="20"
# Predictable per-file generation default. Explicit requests may use more, up to model/provider ceilings.
AI_DEFAULT_MAX_OUTPUT_TOKENS="2000"

# -----------------------------------------------------------------------------
# BROWSER-SAFE SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_REPLACE_ME"

# No local database or local AI credential fallback exists.
# If Supabase is unavailable, the API returns an explicit 503.

