# AI Contracts platform environment configuration
# Never commit real credentials to this repository.

# Server-side encryption secret for credential storage (32+ random characters).
ENCRYPTION_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# Firebase Admin authentication (choose ONE method):
# Method A: complete service-account JSON on the server.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Method B: separate Firebase Admin credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Store the private key server-side. If entered as one line, use literal \\n escapes.
FIREBASE_PRIVATE_KEY=

# Method C: Google Application Default Credentials in a Google-managed runtime.

# Comma-separated administrator email allowlist.
ADMIN_EMAILS="sarveshtiwarisarvesh@gmail.com"

# Public application URL.
APP_URL="MY_APP_URL"

# Firebase client configuration (frontend-safe values only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
