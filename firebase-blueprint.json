{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and AI provider settings configuration",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique identifier of the user (Firebase UID)"
        },
        "email": {
          "type": "string",
          "description": "User's email address"
        },
        "displayName": {
          "type": "string",
          "description": "User's display name"
        },
        "photo": {
          "type": "string",
          "description": "URL to user's profile photo"
        },
        "provider": {
          "type": "string",
          "description": "Active AI provider (openai, groq)"
        },
        "apiKey": {
          "type": "string",
          "description": "Encrypted API key for the active provider"
        },
        "defaultModel": {
          "type": "string",
          "description": "Default model selected for the provider"
        },
        "temperature": {
          "type": "number",
          "description": "Sampling temperature for generations (0.0 to 1.0)"
        },
        "maxTokens": {
          "type": "number",
          "description": "Max tokens for generated responses"
        },
        "createdDate": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user account was created"
        },
        "updatedDate": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the settings were last updated"
        }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user settings and preferences indexed by their Firebase Auth UID"
    }
  }
}
